{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "eggshell",
  "version": "1.0.3",
  "identifier": "gd.rf.faheemanis.eggshell",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "eggshell",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": ["../templates/**/*"],
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyM0FDN0Q4QjZBRjZFRjcKUldUM2JxKzIyTWM2SXBQUmYrdWhjYXk5NWpwVWZYa3NhR0Ztc3VXYkMxd21Obmx0M3ZscTRlOU8K",
      "endpoints": [
        "https://github.com/eggshell-ai/eggshell/releases/download/v1.0.3/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
