<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        body { font-family: dejavusans, sans-serif; font-size: 11px; color: #222; }
        h1 { font-size: 20px; margin: 0 0 4px 0; letter-spacing: 2px; }
        .muted { color: #666; }
        .header { border-bottom: 2px solid #333; padding-bottom: 10px; margin-bottom: 16px; }
        .header td { vertical-align: top; }
        .company { font-weight: bold; font-size: 13px; }
        .meta { text-align: right; }
        .section { margin-bottom: 16px; }
        .label { color: #666; font-size: 9px; text-transform: uppercase; letter-spacing: 1px; }
        table.items { width: 100%; border-collapse: collapse; margin-bottom: 12px; }
        table.items th { text-align: left; background: #f2f2f2; padding: 6px; border-bottom: 1px solid #ccc; }
        table.items td { padding: 6px; border-bottom: 1px solid #eee; }
        table.totals { width: 45%; margin-left: 55%; border-collapse: collapse; }
        table.totals td { padding: 4px 6px; }
        table.totals tr.grand td { border-top: 2px solid #333; font-weight: bold; font-size: 13px; }
        .num { text-align: right; }
        .footer { margin-top: 24px; font-size: 9px; color: #888; text-align: center; }
    </style>
</head>
<body>
<table class="header" width="100%">
    <tr>
        <td>
            <div class="company">{{ invoice.company.name }}</div>
            <div class="muted">{{ invoice.company.address }}</div>
            <div class="muted">
                {{ invoice.company.phone }} &nbsp;·&nbsp; {{ invoice.company.email }}
            </div>
            <div class="muted">Tax No: {{ invoice.company.taxNumber }}</div>
        </td>
        <td class="meta">
            <h1>INVOICE</h1>
            <div><strong>{{ invoice.invNo }}</strong></div>
            <div class="muted">{{ invoice.date }}</div>
        </td>
    </tr>
</table>

<div class="section">
    <div class="label">Billed to</div>
    <div><strong>{{ invoice.customerName }}</strong></div>
    {% if invoice.customerPhone %}<div class="muted">{{ invoice.customerPhone }}</div>{% endif %}
    {% if invoice.customerEmail %}<div class="muted">{{ invoice.customerEmail }}</div>{% endif %}
</div>

<table class="items">
    <thead>
        <tr>
            <th>Item</th>
            <th class="num">Qty</th>
            <th class="num">Unit price</th>
            <th class="num">Total</th>
        </tr>
    </thead>
    <tbody>
        {% for item in invoice.items %}
            <tr>
                <td>{{ item.name }}</td>
                <td class="num">{{ item.quantity }}</td>
                <td class="num">{{ item.unitPrice|number_format(2) }}</td>
                <td class="num">{{ item.total|number_format(2) }}</td>
            </tr>
        {% else %}
            <tr><td colspan="4" class="muted">No line items.</td></tr>
        {% endfor %}
    </tbody>
</table>

<table class="totals">
    {% for tax in invoice.taxes %}
        <tr>
            <td>{{ tax.name }} ({{ tax.rate|number_format(2) }}%)</td>
            <td class="num">{{ tax.amount|number_format(2) }}</td>
        </tr>
    {% endfor %}
    <tr class="grand">
        <td>Total</td>
        <td class="num">{{ invoice.total|number_format(2) }}</td>
    </tr>
</table>

<div class="footer">
    Generated by {{ invoice.company.name }} — {{ invoice.invNo }}
</div>
</body>
</html>
